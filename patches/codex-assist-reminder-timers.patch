+        (None, None, "напомни выключить таймер", False),
+        (None, None, "не ставь таймер", False),
+        (None, None, "Set a kitchen timer for one minute", True),
+    ],
+)
+def test_reminder_tools_separate_timer_dispatch_from_reminder_turn(
+    conversation_module, initial, question, reply, allow
+):
+    @dataclass
+    class API:
+        tools: list
+
+    timer = SimpleNamespace(name="intent__HassStartTimer")
+    fgr = SimpleNamespace(name="fiendishly_reminders__schedule")
+    unrelated = SimpleNamespace(name="intent__HassTurnOn")
+    api = API([timer, fgr, unrelated])
+    history = [] if initial is None else [
+        FakeContent("user", initial), FakeContent("assistant", question)
+    ]
+    history.append(FakeContent("user", reply))
+    chat_log = FakeChatLog(history, api)
+    scoped = conversation_module._llm_api_for_turn(chat_log, reply)
+    assert scoped.tools == ([timer, fgr, unrelated] if allow else [fgr, unrelated])
+    assert api.tools == [timer, fgr, unrelated]
+
+    without_fgr = API([timer, unrelated])
+    chat_log.llm_api = without_fgr
+    assert conversation_module._llm_api_for_turn(chat_log, reply) is without_fgr
+
