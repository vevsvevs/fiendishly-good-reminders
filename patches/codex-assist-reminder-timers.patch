+def _timer_requested(text: str, content: list[Any]) -> bool:
+    """Authorize a new timer from explicit user text or a timer clarification."""
+    if _TIMER_REQUEST.search(text.strip()):
+        return True
+
+    turns = [item for item in content if item.role in {"user", "assistant"}]
+    if turns and turns[-1].role == "user" and turns[-1].content == text:
+        turns.pop()
+    if len(turns) < 2:
+        return False
+    request, question = turns[-2:]
+    if request.role != "user" or question.role != "assistant" or question.tool_calls:
+        return False
+    question_text = (question.content or "").strip()
+    return (
+        question_text.endswith(("?", "？"))
+        and not _REMINDER_WORD.search(question_text)
+        and not _REMINDER_WORD.search(text)
+        and not text.strip().casefold().startswith(("не ", "нет", "no ", "don't ", "do not "))
+        and bool(_TIMER_DURATION_REPLY.fullmatch(text.strip()))
+        and bool(_TIMER_REQUEST.search((request.content or "").strip()))
+        and bool(
+            _TIMER_WORD.search(question_text) or _TIMER_DURATION_QUESTION.search(question_text)
+        )
+    )
+
+
+def _llm_api_for_turn(chat_log: conversation.ChatLog, text: str) -> llm.APIInstance | None:
+    """Filter timer creation for both the advertised tools and HA dispatch."""
+    api = chat_log.llm_api
+    if api is None or not any(
+        tool.name.split("__")[-2:-1] == [_REMINDER_TOOL_DOMAIN] for tool in api.tools
+    ):
+        return api
+    if _timer_requested(text, chat_log.content):
+        return api
+    return replace(api, tools=[
+        tool for tool in api.tools if tool.name.rsplit("__", 1)[-1] != _START_TIMER_TOOL
+    ])
+
